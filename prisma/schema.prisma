generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Notebook {
  id                 String         @id @default(uuid())
  title              String
  backgroundNoteSlug String?
  userId             String?
  user               User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages              NotebookPage[]
  createdAt          DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model NotebookPage {
  id         String   @id @default(uuid())
  pageNumber Int      // Order of the pages
  canvasData String   // Serialized paths string "[]"
  notebookId String
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// --- Vídeos e Disciplinas ---

model AreaConhecimento {
  id          String       @id @default(uuid())
  nome        String       @unique // ex: Ciências da Natureza
  disciplinas Disciplina[]
  questoes    Questao[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Disciplina {
  id                 String           @id @default(uuid())
  nome               String           @unique // ex: Física
  areaConhecimentoId String
  areaConhecimento   AreaConhecimento @relation(fields: [areaConhecimentoId], references: [id], onDelete: Cascade)
  assuntos           Assunto[]
  questoes           Questao[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Assunto {
  id           String     @id @default(uuid())
  nome         String     // ex: Cinemática
  disciplinaId String
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  aulas        Aula[]
  questoes     Questao[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Aula {
  id         String       @id @default(uuid())
  titulo     String // ex: Introdução à Cinemática
  videoUrl   String? // URL ou ID do vídeo (YouTube, Vimeo, etc)
  descricao  String? // Descrição da aula
  concluida  Boolean      @default(false)
  avaliacao  Int? // Avaliação de 1 a 5
  ordem      Int          @default(0) // Ordem da aula dentro do assunto
  assuntoId  String
  assunto    Assunto      @relation(fields: [assuntoId], references: [id], onDelete: Cascade)
  materiais  Material[]
  comentarios Comentario[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Material {
  id        String   @id @default(uuid())
  nome      String
  url       String
  aulaId    String
  aula      Aula     @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comentario {
  id        String   @id @default(uuid())
  conteudo  String
  aulaId    String
  aula      Aula     @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Questao {
  id                 String   @id @default(uuid())
  textoBase          String   // Texto ou HTML contendo texto e imagens
  referencia         String?  // ex: Adaptado de...
  comando            String   // O "comando" da questão
  alternativas       String   // JSON stringified com as alternativas e qual é a correta
  instituicao        String?  // ex: ENEM, FUVEST
  ano                Int?
  dificuldade        String?  // Fácil, Médio, Difícil
  
  // Relações
  areaConhecimentoId String
  areaConhecimento   AreaConhecimento @relation(fields: [areaConhecimentoId], references: [id])
  disciplinaId       String
  disciplina         Disciplina       @relation(fields: [disciplinaId], references: [id])
  assuntoId          String
  assunto            Assunto          @relation(fields: [assuntoId], references: [id])

  // Status (Simplificado para banco local/single-user)
  jaAcertei          Boolean @default(false)
  jaErrei            Boolean @default(false)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// --- Autenticação (NextAuth.js) ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  notebooks     Notebook[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
